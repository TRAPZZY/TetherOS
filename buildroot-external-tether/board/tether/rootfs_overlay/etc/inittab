# BusyBox init configuration for TetherOS / TRAP HUB.
::sysinit:/etc/init.d/rcS
tty1::respawn:/sbin/getty -L -n -l /usr/bin/tether-login 0 tty1 linux
ttyS0::respawn:/sbin/getty -L -n -l /usr/bin/tether-login 115200 ttyS0 vt100
::shutdown:/etc/init.d/S04trap-hub-control stop
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
