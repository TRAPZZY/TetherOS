#!/bin/sh
# Tether OS boot sequence
echo "Tether OS v1.1.2 -- booting..."

# Mount kernel filesystems
mount -t proc none /proc
mount -t sysfs none /sys

# Remount rootfs read-write
mount -o remount,rw /

# tmpfs for runtime data
mount -t tmpfs tmpfs /run
mkdir -p /run/network
mount -t tmpfs tmpfs /tmp
mkdir -p /dev/pts
mount -t devpts none /dev/pts

# Populate /dev
if [ -w /proc/sys/kernel/hotplug ]; then
    echo "/sbin/mdev" > /proc/sys/kernel/hotplug
fi
mdev -s

# Bring up loopback interface
ip link set lo up

dmesg -n 1

echo "Starting services..."
service_failures=0
firewall_ready=0
for i in /etc/init.d/S*; do
    if [ -x "$i" ]; then
        case "$i" in
            */S01iptables)
                if "$i" start; then
                    firewall_ready=1
                else
                    service_failures=1
                fi
                ;;
            */S02network|*/S03tor)
                if [ "$firewall_ready" -eq 1 ]; then
                    "$i" start || service_failures=1
                else
                    echo "  [FAIL] Skipping $(basename "$i") because the kill switch is unavailable"
                    service_failures=1
                fi
                ;;
            *)
                "$i" start || service_failures=1
                ;;
        esac
    fi
done

if [ "$service_failures" -eq 0 ]; then
    echo "Tether OS ready."
else
    echo "Tether OS restricted mode: one or more critical services failed."
fi
