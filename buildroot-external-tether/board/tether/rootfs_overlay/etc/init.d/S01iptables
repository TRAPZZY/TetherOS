#!/bin/sh
# Fail-closed firewall: only the Tor service may create internet traffic.

case "$1" in
    start)
        set -e
        echo "  [....] Enabling Tor kill switch..."
        iptables -w -F
        iptables -w -t nat -F
        iptables -w -P INPUT DROP
        iptables -w -P FORWARD DROP
        iptables -w -P OUTPUT DROP

        TOR_UID="$(id -u tor 2>/dev/null)" || {
            echo "  [FAIL] Tor service account is missing; firewall remains closed"
            exit 1
        }

        # Local applications may reach Tor's loopback SOCKS/control ports.
        iptables -w -A INPUT -i lo -j ACCEPT
        iptables -w -A OUTPUT -o lo -j ACCEPT

        # DHCP is required before an internet route exists.
        iptables -w -A OUTPUT -p udp --sport 68 --dport 67 -j ACCEPT
        iptables -w -A INPUT -p udp --sport 67 --dport 68 -j ACCEPT

        # Only the unprivileged Tor account may establish external flows.
        iptables -w -A OUTPUT -m owner --uid-owner "$TOR_UID" -j ACCEPT

        iptables -w -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
        iptables -w -A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
        echo "  [OK] Tor kill switch active."
        ;;
    stop)
        echo "  [WARN] Disabling kill switch"
        iptables -w -F
        iptables -w -t nat -F
        iptables -w -P INPUT ACCEPT
        iptables -w -P FORWARD ACCEPT
        iptables -w -P OUTPUT ACCEPT
        ;;
    status)
        iptables -S OUTPUT
        ;;
    *)
        echo "Usage: $0 {start|stop|status}"
        exit 1
        ;;
esac
