#!/bin/sh
# TetherOS boot handoff. BusyBox init remains PID 1 and owns all sessions.

export TETHER_BOOT_IMAGE=1
export TRAP_HUB_SESSION=1

exec /sbin/init

# Never expose an unauthenticated rescue shell in a production image.
echo "FATAL: unable to start the TetherOS service supervisor" > /dev/console
while :; do
    sleep 60
done
