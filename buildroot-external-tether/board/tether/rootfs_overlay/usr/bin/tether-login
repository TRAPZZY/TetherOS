#!/bin/sh
# Trusted greeter for the fixed, non-root TRAP HUB operator account.
set -u

STATE_DIR=/run/tether
READY_FILE="$STATE_DIR/password-ready"
SETUP_LOCK="$STATE_DIR/password-setup.lock"

mkdir -p "$STATE_DIR"
chmod 0750 "$STATE_DIR"

wait_for_setup_trigger() {
    while [ ! -f "$READY_FILE" ]; do
        if IFS= read -r -t 1 _answer; then
            return 0
        fi
    done
    return 1
}

if [ ! -f "$READY_FILE" ]; then
    printf '\n  TRAP HUB // SECURE SESSION SETUP\n'
    printf '  Press ENTER to create the password for this boot session.\n'

    if wait_for_setup_trigger; then
        if mkdir "$SETUP_LOCK" 2>/dev/null; then
            trap 'rm -rf "$SETUP_LOCK"' EXIT INT TERM HUP
            printf '%s\n' "$$" > "$SETUP_LOCK/pid"
            if [ ! -f "$READY_FILE" ]; then
                until passwd tether; do
                    printf '  Password setup failed. Please try again.\n'
                done
                umask 077
                : > "$READY_FILE"
                printf '  [OK] TRAP HUB session password configured.\n'
            fi
            rm -rf "$SETUP_LOCK"
            trap - EXIT INT TERM HUP
        else
            printf '  Password setup is active on another console. Waiting...\n'
            while [ ! -f "$READY_FILE" ]; do
                if [ -r "$SETUP_LOCK/pid" ]; then
                    owner_pid="$(cat "$SETUP_LOCK/pid" 2>/dev/null || true)"
                    if [ -n "$owner_pid" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
                        rm -rf "$SETUP_LOCK"
                        exec "$0"
                    fi
                fi
                sleep 1
            done
        fi
    fi
fi

mkdir -p /run/user/1000
chown tether:tether /run/user/1000
chmod 0700 /run/user/1000

session_tty="$(tty 2>/dev/null || true)"
if [ "$session_tty" = "/dev/tty1" ]; then
    umask 077
    : > /run/user/1000/trap-hub-local-login.ready
    chown tether:tether /run/user/1000/trap-hub-local-login.ready
    if [ -w /dev/ttyS0 ]; then
        printf 'TRAP HUB local login ready\n' > /dev/ttyS0
    fi
fi

exec /bin/login tether
